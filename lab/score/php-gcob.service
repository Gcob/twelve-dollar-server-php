# The submission's service on the server box, as the bench names it: the challenge's LEADERBOARD names only LimitNOFILE and the ambient
# capability for the port. Everything else a unit could set (the restart policy aside, which is "no" because the score search restarts the
# server itself) is unknown, so it is left out: no tuning beyond what a droplet's unit would have.
[Unit]
Description=php-Gcob, the $12 server challenge's submission

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/php-Gcob
Environment=SQLITE_PATH=/srv/data/feed.db
Environment=JWT_SECRET=twelve-dollar-challenge
Environment=HOST=0.0.0.0
Environment=PORT=80
ExecStart=/usr/bin/bash /srv/php-Gcob/start.sh
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=no

[Install]
WantedBy=multi-user.target
