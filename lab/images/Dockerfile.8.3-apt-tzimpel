# php-lab:8.3-apt-tzimpel: php-lab:8.3-apt plus a second Swoole 6.2.6 with the php-swoole-tzimpel entry's memory patch, in
# /opt/swoole-tzimpel/swoole.so (see install-swoole-tzimpel.sh). Build through lab/build.sh (after 8.3-apt), never by hand: the build
# context is lab/images/.
FROM php-lab:8.3-apt

COPY install-swoole-tzimpel.sh /tmp/install.sh
RUN bash /tmp/install.sh && rm /tmp/install.sh
