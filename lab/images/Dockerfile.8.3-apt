# php-lab:8.3-apt: Ubuntu 24.04 + PHP 8.3 from apt + Swoole built from source (see install-php83-apt.sh).
# Build through lab/build.sh, never by hand: the build context is lab/images/.
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289

COPY install-php83-apt.sh /tmp/install.sh
RUN bash /tmp/install.sh && rm /tmp/install.sh

COPY php-info /usr/local/bin/php-info
RUN chmod +x /usr/local/bin/php-info
